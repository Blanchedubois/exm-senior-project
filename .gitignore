# Only the three tracker folders are versioned; everything else in this
# iCloud folder (older trackers, zips, archives) stays local.
/*
!/.gitignore
!/README.md
!/blog/
!/proposal/
!/ArUco_Reference_Tagger/
!/ArUco_Tracker_V2/
!/Reference_Warp_Tagger/

# large image data stays on iCloud, not in git
*.tif
*.tiff

# python / editor / OS noise
__pycache__/
*.pyc
.venv/
venv/
.DS_Store

# dummy series: the generator script, truth.json, truth_meta.json and READMEs are
# committed; the frames, the per-feature truth CSVs and the design copies are
# regenerated by `python ArUco_Tracker_V2/tools/make_dummy_series.py --preset all`
ArUco_Tracker_V2/dummy/**/truth_*.csv
ArUco_Tracker_V2/dummy/**/reference_tags.json
ArUco_Tracker_V2/dummy/**/_cli/
# sidecars and projects made while trying the app on the dummy frames
ArUco_Tracker_V2/dummy/**/*.rwmeta.json
ArUco_Tracker_V2/dummy/**/*.rwsession.json
ArUco_Tracker_V2/dummy/**/*.rwproj.json
