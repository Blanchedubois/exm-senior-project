# Large image data stays out of git (microscope frames, simulator stacks)
*.tif
*.tiff
*.ome.tif

# Raw lab-notebook audio stays on iCloud; notes, transcripts and images are committed
lab-notebook/**/audio/
lab-notebook/**/*.m4a

# IX83 bead analysis: derived outputs are regenerated from the experiment JSON
projects/ix83-bead-analysis/outputs/

# Dummy series for the ArUco tagger: the generator, truth.json, truth_meta.json and
# READMEs are committed; frames, per-feature truth CSVs and design copies are
# regenerated by `python projects/aruco-marker-design/tools/make_dummy_series.py --preset all`
projects/aruco-marker-design/dummy/**/truth_*.csv
projects/aruco-marker-design/dummy/**/reference_tags.json
projects/aruco-marker-design/dummy/**/_cli/
projects/aruco-marker-design/dummy/**/*.rwmeta.json
projects/aruco-marker-design/dummy/**/*.rwsession.json
projects/aruco-marker-design/dummy/**/*.rwproj.json

# Python / editor / OS noise
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
.DS_Store
build/
